# The pgrust contestant of the borg benchmark, in pgrust-db-rust; installed to
# /etc/systemd/system by install-pgrust.sh. The settings come from the data
# directory's postgresql.conf (its "# bench begin/end" block); the command line
# carries only what pgrust itself needs (its README's options and the two C
# defaults pgrust changes). LimitSTACK is ulimit -s 65520 in bytes.
[Unit]
Description=pgrust (PostgreSQL 18.6 in Rust) for the borg benchmark
After=network.target

[Service]
User=pgrust
LimitSTACK=67092480
Environment=RUST_MIN_STACK=33554432
ExecStart=/opt/pgrust/postgres -D /srv/pgrust/data -k /tmp -p 5432 -c io_method=sync -c max_stack_depth=60000 -c max_parallel_workers_per_gather=2 -c min_parallel_table_scan_size=8MB
KillSignal=SIGINT
TimeoutStopSec=120
Restart=no

[Install]
WantedBy=multi-user.target
