-- One k-NN search with a random test query (queries.id 0..9999), top 10.
-- Run with -D tbl=items -D qcol=v -D op='<=>' (vector) or
-- -D tbl=items_h -D qcol=vh -D op='<=>' (halfvec); '<->' for L2 datasets.
-- pgbench substitutes :var verbatim, so the query vector is fetched as a
-- quoted literal and lands in the search as '[...]', resolved against the
-- column's type: the same SQL text recall.py sends. The search setting comes
-- per connection from PGOPTIONS="-c hnsw.ef_search=N" (or ivfflat.probes).
\set qid random(0, 9999)
SELECT quote_literal(:qcol::text) AS qv FROM queries WHERE id = :qid \gset
SELECT id FROM :tbl ORDER BY v :op :qv LIMIT 10;
