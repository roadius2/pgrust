diff -ruN /Users/jody/dev_projects/pgrust/crates/pgvector-0.8.7-reference/src/hnswshadow.h pgv-src/src/hnswshadow.h
--- /Users/jody/dev_projects/pgrust/crates/pgvector-0.8.7-reference/src/hnswshadow.h	1969-12-31 19:00:00
+++ pgv-src/src/hnswshadow.h	2026-10-05 12:41:28
@@ -0,0 +1,176 @@
+/* Shadow model of aset.c accounting for the hnsw scan tmpCtx (validation only). */
+#ifndef HNSWSHADOW_H
+#define HNSWSHADOW_H
+#include "postgres.h"
+#include "nodes/pg_list.h"
+#include "port/pg_bitutils.h"
+
+typedef struct HnswShadow
+{
+	MemoryContext ctx;			/* model applies only while this is current */
+	Size		mem_allocated;
+	Size		avail;			/* endptr - freeptr of set->blocks (head) */
+	int			nfree[11];
+	Size		nextBlockSize;
+} HnswShadow;
+
+extern HnswShadow hnsw_shadow;
+extern FILE *hnsw_shadow_log;
+#define SHADOW_LOG(...) do { if (hnsw_shadow_log && SHADOW_ON()) fprintf(hnsw_shadow_log, __VA_ARGS__); } while (0)
+
+#define SHADOW_ON() (hnsw_shadow.ctx != NULL && CurrentMemoryContext == hnsw_shadow.ctx)
+
+static inline int
+shadow_fidx(Size size)
+{
+	if (size > 8)
+		return pg_leftmost_one_pos32((uint32) ((size - 1) >> 3)) + 1;
+	return 0;
+}
+
+static inline void
+shadow_reset(void)
+{
+	if (hnsw_shadow_log)
+		fprintf(hnsw_shadow_log, "R\n");
+	hnsw_shadow.mem_allocated = 8192;
+	hnsw_shadow.avail = 8192 - 200 - 40;
+	memset(hnsw_shadow.nfree, 0, sizeof(hnsw_shadow.nfree));
+	hnsw_shadow.nextBlockSize = 8192;
+}
+
+static inline void
+shadow_alloc(Size size)
+{
+	int			fidx;
+	Size		chunk_size;
+	Size		blksize;
+
+	if (!SHADOW_ON())
+		return;
+	SHADOW_LOG("A %zu\n", size);
+	if (size > 8192)
+	{
+		hnsw_shadow.mem_allocated += MAXALIGN(size) + 40 + 8;
+		return;
+	}
+	fidx = shadow_fidx(size);
+	if (hnsw_shadow.nfree[fidx] > 0)
+	{
+		hnsw_shadow.nfree[fidx]--;
+		return;
+	}
+	chunk_size = ((Size) 8) << fidx;
+	if (hnsw_shadow.avail >= chunk_size + 8)
+	{
+		hnsw_shadow.avail -= chunk_size + 8;
+		return;
+	}
+	while (hnsw_shadow.avail >= 16)
+	{
+		Size		availchunk = hnsw_shadow.avail - 8;
+		int			a = shadow_fidx(availchunk);
+
+		if (availchunk != (((Size) 8) << a))
+		{
+			a--;
+			availchunk = ((Size) 8) << a;
+		}
+		hnsw_shadow.nfree[a]++;
+		hnsw_shadow.avail -= availchunk + 8;
+	}
+	blksize = hnsw_shadow.nextBlockSize;
+	hnsw_shadow.nextBlockSize <<= 1;
+	if (hnsw_shadow.nextBlockSize > 256 * 1024)
+		hnsw_shadow.nextBlockSize = 256 * 1024;
+	while (blksize < chunk_size + 40 + 8)
+		blksize <<= 1;
+	hnsw_shadow.mem_allocated += blksize;
+	hnsw_shadow.avail = blksize - 40 - chunk_size - 8;
+}
+
+static inline void
+shadow_free(Size size)
+{
+	if (!SHADOW_ON())
+		return;
+	SHADOW_LOG("F %zu\n", size);
+	if (size > 8192)
+	{
+		hnsw_shadow.mem_allocated -= MAXALIGN(size) + 40 + 8;
+		return;
+	}
+	hnsw_shadow.nfree[shadow_fidx(size)]++;
+}
+
+/* repalloc of a small chunk (aset.c AllocSetRealloc): grow only across classes */
+static inline void
+shadow_realloc(Size oldsize, Size newsize)
+{
+	if (!SHADOW_ON())
+		return;
+	if (oldsize <= 8192 && newsize <= 8192 && (((Size) 8) << shadow_fidx(oldsize)) >= newsize)
+		return;
+	shadow_alloc(newsize);
+	shadow_free(oldsize);
+}
+
+/* Account an lappend given the list state before it */
+static inline void
+shadow_lappend(List *before, int before_max, bool before_inline)
+{
+	if (before == NIL)
+	{
+		shadow_alloc(64);		/* new_list(1): 24 + 5 * 8 */
+		return;
+	}
+	if (before->length + 1 > before_max)
+	{
+		int			newmax = pg_nextpower2_32(Max(16, before->length + 1));
+
+		if (before_inline)
+			shadow_alloc(newmax * sizeof(ListCell));
+		else
+			shadow_realloc(before_max * sizeof(ListCell), newmax * sizeof(ListCell));
+	}
+}
+
+#define SHADOW_LAPPEND(lst, item) \
+	do { \
+		List *b_ = (lst); \
+		int bm_ = b_ ? b_->max_length : 0; \
+		bool bi_ = b_ ? b_->elements == b_->initial_elements : false; \
+		int bl_ = b_ ? b_->length : 0; \
+		(lst) = lappend((lst), (item)); \
+		shadow_lappend_len(b_ == NIL, bl_, bm_, bi_); \
+	} while (0)
+
+static inline void
+shadow_lappend_len(bool was_nil, int len, int max, bool was_inline)
+{
+	if (was_nil)
+	{
+		shadow_alloc(64);
+		return;
+	}
+	if (len + 1 > max)
+	{
+		int			newmax = pg_nextpower2_32(Max(16, len + 1));
+
+		if (was_inline)
+			shadow_alloc(newmax * sizeof(ListCell));
+		else
+			shadow_realloc(max * sizeof(ListCell), newmax * sizeof(ListCell));
+	}
+}
+
+/* list_free of a List built by lappend */
+static inline void
+shadow_list_free(int max, bool is_inline)
+{
+	if (!is_inline)
+		shadow_free(max * sizeof(ListCell));
+	shadow_free(64);
+}
+
+#endif
